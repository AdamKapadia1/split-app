# Public client configuration. These values are safe to ship in the Expo app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ANTHROPIC_API_KEY is a Supabase Edge Function secret, not a client variable.
# Set it in the Supabase project (never in the Expo bundle):
#   supabase secrets set ANTHROPIC_API_KEY=...
# The app calls the scan-receipt function with the signed-in user's JWT.
# Do not add EXPO_PUBLIC_ANTHROPIC_API_KEY.
